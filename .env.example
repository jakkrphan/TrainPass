# Database
DATABASE_URL="mysql://checkinhub:local_password@localhost:3307/checkinhub"

# Organizer authentication
AUTH_SECRET="replace-with-at-least-32-random-bytes"
AUTH_TRUST_HOST="true"

# Dev only: hostnames/IPs (comma-separated, no scheme or port) allowed to open `npm run dev` from other machines.
# DEV_ALLOWED_ORIGINS="192.168.1.20"

# Staff sign-in with Active Directory / LDAP — off while LDAP_URL is empty (then email + local password only).
# Accounts with a local password (e.g. the break-glass admin) can still sign in with email + that password.
# Use ldaps:// (or LDAP_STARTTLS="true"): a plain ldap:// bind sends the password unencrypted.
# Same names as the portalrpp .env, so its values can be reused (LDAP_ATTRIBUTES/IDLE_TIMEOUT/RECONNECT are not used here).
LDAP_URL=""
LDAP_BASE_DN=""                       # e.g. DC=rpphosp,DC=local
LDAP_BIND_DN=""                       # read-only service account: a DN or a UPN such as svc-checkinhub@rpphosp.local
LDAP_BIND_PASSWORD=""
# LDAP_SEARCH_FILTER="(&(objectCategory=person)(objectClass=user)(|(sAMAccountName={{username}})(userPrincipalName={{username}})(mail={{username}})))"
# LDAP_REQUIRED_OU="rpp-user"         # only entries under this OU may sign in
# LDAP_AUTO_PROVISION="false"         # "true": first AD sign-in without an account here creates an ORGANIZER account
# LDAP_STARTTLS="false"
# LDAP_TLS_CA_FILE=""                 # PEM of the organisation CA when the AD certificate is not publicly trusted
# LDAP_TLS_REJECT_UNAUTHORIZED="true"
# LDAP_TIMEOUT="5000"                 # milliseconds
# LDAP_CONNECT_TIMEOUT="5000"

# Public origin, no trailing slash: registration links/QR, staff invite links, target of the maintenance scripts.
# Unset: links use the request host and the scripts call http://localhost:3100. See docs/OPERATIONS.md.
# APP_BASE_URL="https://checkin.example.org"

# Sub-path the app is served under (e.g. https://host/trainpass). Origin-only APP_BASE_URL stays as above; links, cookies,
# Auth.js and the maintenance scripts add this path. Build-time: rebuild after changing. Unset = domain root.
# BASE_PATH="/trainpass"

# Email notifications (SMTP). Port 465 uses implicit TLS; port 587 requires STARTTLS.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@example.com"

# LINE — two channels under the SAME provider (otherwise the user ID from Login cannot receive pushes from the OA).
# LINE Login channel: registrant sign-in. Register the callback URL <APP_BASE_URL>/api/line/callback and link the OA.
LINE_LOGIN_CHANNEL_ID=""
LINE_LOGIN_CHANNEL_SECRET=""
# Messaging API channel (the OA): push messages; the channel secret verifies webhook signatures.
# The access token is the long-lived "Channel access token" (~170 characters), not a user ID.
LINE_MESSAGING_CHANNEL_ID=""
LINE_MESSAGING_CHANNEL_SECRET=""
LINE_MESSAGING_ACCESS_TOKEN=""

# Attachments and cover images on this server's disk: a private folder outside the app (never under public/),
# writable only by the app's user and included in backups. Production refuses uploads while it is empty;
# development falls back to .local-uploads/.
UPLOAD_DIR=""                         # e.g. /srv/checkinhub-uploads

# Feature switches (off unless "true")
# Self check-in kiosk with staff PIN — default only; admins switch it in /admin?view=settings
FEATURE_KIOSK="false"

# Authenticated scheduled maintenance (pending-seat expiry every ~15 min, PDPA retention daily)
CRON_SECRET=""
